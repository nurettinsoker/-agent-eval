# =============================================================================
# Agent-Eval Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys and settings

# =============================================================================
# API Keys
# =============================================================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# Dashboard Configuration
# =============================================================================

# Dashboard API URL (for pushing results)
DASHBOARD_API_URL=http://localhost:3000/api

# Dashboard Project ID
DASHBOARD_PROJECT_ID=my-project

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
# LOG_FILE=agent-eval.log

# =============================================================================
# Performance
# =============================================================================

# Maximum concurrent test executions
MAX_CONCURRENT_TESTS=3

# Test timeout in seconds
TEST_TIMEOUT=30

# =============================================================================
# Database (Dashboard)
# =============================================================================

# Database URL for Dashboard
# Default: SQLite in ./prisma/dev.db
# DATABASE_URL=file:./prisma/dev.db

# =============================================================================
# Optional: Custom Agent Endpoints
# =============================================================================

# Custom HTTP endpoint URL
# CUSTOM_AGENT_URL=http://localhost:8000/api/chat

# Custom agent API key/token
# CUSTOM_AGENT_TOKEN=your-token-here

# =============================================================================
# Development
# =============================================================================

# Development mode: true/false
DEVELOPMENT=false

# Mock mode (use mock agent without API keys): true/false
MOCK_MODE=false

# =============================================================================
# Optional: LLM Judge Configuration
# =============================================================================

# LLM Judge model
# LLM_JUDGE_MODEL=gpt-4o-mini

# LLM Judge temperature (0-2, default: 0.7)
# LLM_JUDGE_TEMPERATURE=0.7

# =============================================================================
# Optional: Semantic Similarity Configuration
# =============================================================================

# Semantic similarity model
# SEMANTIC_MODEL=all-MiniLM-L6-v2

# Semantic similarity threshold (0-1, default: 0.75)
# SEMANTIC_THRESHOLD=0.75
